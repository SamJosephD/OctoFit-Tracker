# Frontend environment variables for OctoFit Tracker
# Copy this file to .env and update values as needed.

# Backend API URL for local development
REACT_APP_BACKEND_URL=http://localhost:8000

# Codespaces environment support
# If running in Codespaces, set this to your codespace name
# or leave it unset to let the app infer the host.
REACT_APP_CODESPACE_NAME=
